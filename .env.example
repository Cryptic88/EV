# Keep your real Groq key in .env, which is ignored by Git.
GROQ_API_KEY=
LLM_BACKEND=groq
GROQ_MODEL=openai/gpt-oss-20b
# To use a local Ollama server, set LLM_BACKEND=ollama.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b

TTS_BACKEND=kokoro
KOKORO_VOICE=af_bella
KOKORO_LANGUAGE=en-us
KOKORO_SPEED=1.0
SENTENCE_PAUSE_SECONDS=0.35
TTS_ALLOW_EDGE_FALLBACK=false
EDGE_VOICE=en-US-JennyNeural

WHISPER_MODEL_SIZE=small.en
# Input device index or name + audio driver; empty uses Windows default.
MICROPHONE_DEVICE=
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
VAD_BACKEND=silero
VAD_THRESHOLD=0.5
COMMAND_START_TIMEOUT=5
SILENCE_DURATION=0.8
FOLLOW_UP_SECONDS=8
REPLY_TAIL_SECONDS=0.2
AUTOMATION_ROOTS=C:/Users/rynop/Documents
AUTOMATION_TIMEZONE=Africa/Johannesburg
MAX_TOOL_ROUNDS=10

# Vosk already recognizes E.V.; openWakeWord needs a trained E.V. ONNX file.
WAKE_BACKEND=vosk
WAKE_MODEL_PATH=
WAKE_THRESHOLD=0.5
